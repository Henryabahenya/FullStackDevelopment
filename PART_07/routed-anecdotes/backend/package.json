{
  "name": "routed-anecdotes-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon index.js",
    "build-frontend": "npm run build --prefix ../frontend",
    "clean-build": "npx rimraf build",
    "copy-frontend": "npx cpx \"../frontend/dist/**/*\" build",
    "build": "npm-run-all build-frontend clean-build copy-frontend",
    "build:prod": "npm-run-all build-frontend clean-build copy-frontend",
    "start": "node index.js"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "cpx": "^1.5.0",
    "nodemon": "^2.0.22",
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.0"
  }
}
